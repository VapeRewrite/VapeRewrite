{
	"name": "vape-rewrite",
	"version": "0.0.0",
	"description": "",
	"author": "Seized and Desisted",
	"contributors": [
		"TheM1ddleM1n"
	],
	"workspaces": [
		"packages/*",
		"games/*"
	],
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.4"
	},
	"scripts": {
		"dev": "rolldown -wc",
		"clean": "del-cli dist",
		"ci": "bun run lint",
		"build": "rolldown -c",
		"build:prod": "cross-env NODE_ENV=production rolldown -c",
		"lint": "oxlint check packages/*/src",
		"lint:fix": "oxlint check packages/*/src --fix",
		"fmt": "oxfmt check packages/*/src"
	},
	"catalog": {
		"@solidjs/web": "2.0.0-rc.13",
		"solid-js": "2.0.0-rc.13"
	},
	"dependencies": {
		"@wq2/brigadier-ts": "^1.0.8",
		"@wq2/event-bus": "^0.1.0",
		"oxc-minify": "^0.152.0",
		"rolldown": "^1.2.12",
		"solid-js": "catalog:",
		"@solidjs/web": "catalog:"
	},
	"devDependencies": {
		"@solidjs/compiler": "^2.0.0-rc.13",
		"@types/bun": "^1.4.3",
		"@violentmonkey/types": "^0.3.3",
		"@wq2/rolldown-plugin-swc": "^0.0.2",
		"cross-env": "^10.1.0",
		"del-cli": "^7.0.0",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"read-package-up": "^12.0.0",
		"rolldown-plugin-userscript": "^1.1.5",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*.{ts,tsx,js,css}": [
			"oxlint --fix"
		]
	},
	"trustedDependencies": [
		"@swc/core"
	]
}
